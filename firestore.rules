rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rankings/{rankingId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 12
        && request.resource.data.score is int
        && request.resource.data.score >= 1
        && request.resource.data.score <= 100000000
        && request.resource.data.floor == request.resource.data.score
        && request.resource.data.money is int
        && request.resource.data.money >= 0
        && request.resource.data.money <= 1000000000
        && request.resource.data.luck is int
        && request.resource.data.luck >= -1000000
        && request.resource.data.luck <= 1000000
        && request.resource.data.keys().hasOnly(['uid','name','score','floor','money','luck','createdAt']);
      allow update: if false;
      // 無料版ではスコア登録後のTop50整理をクライアント側で行うため、
      // 匿名認証済みユーザーに削除を許可します。
      allow delete: if request.auth != null;
    }
  }
}
